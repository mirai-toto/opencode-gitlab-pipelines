{
  "name": "opencode-gitlab-pipelines",
  "version": "0.1.0",
  "description": "Read-only GitLab pipelines, jobs, and logs in the OpenCode V2 sidebar",
  "repository": "https://github.com/mirai-toto/opencode-gitlab-pipelines",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": ["src", "dist", "tsconfig.json"],
  "keywords": ["opencode", "gitlab", "pipelines", "tui"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:tui": "BUN_BE_BUN=1 opencode scripts/build.ts",
    "test": "bash scripts/test.sh",
    "test:package": "bash scripts/test-package.sh",
    "test:runtime": "bash scripts/test-runtime.sh",
    "check": "npm run typecheck && npm test && npm run build:tui && npm run test:package"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5 <3",
    "@opentui/core": ">=0.8.0 <0.9",
    "@opentui/solid": ">=0.8.0 <0.9",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
